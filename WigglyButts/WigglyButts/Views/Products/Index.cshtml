@model IEnumerable<WigglyButts.Models.Product>

<h2>Dog Toy Store</h2>
<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4">
            <img src="@item.ImageUrl" style="width:200px; height:200px;" />
            <h4>@item.Name</h4>
            <p>Price: @item.Price.ToString("C")</p>
            <a href="#">Add to Cart (Coming Soon)</a>
        </div>
    }
</div>

